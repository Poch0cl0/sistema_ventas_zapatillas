PORT=3000
CHECKOUT_SIMULATION_ENABLED=true
FIREBASE_PROJECT_ID=snakerstore-e74cd
# Ruta local relativa a snakerstore_backend o absoluta. Nunca subir este archivo JSON.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Completar las tres variables para habilitar las imágenes de catálogo.
# Si aún no se usa Cloudinary, omitirlas todas.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rutas: clave solo en el backend. Reemplazar las coordenadas por las de la tienda.
ORS_API_KEY=your_ors_api_key
ORS_BASE_URL=https://api.heigit.org
ORS_STORE_LAT=40.4168
ORS_STORE_LON=-3.7038
# Opcionales: proveedor del mapa y atribución, modificables sin recompilar Flutter.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors · openstreetmap.org/copyright

# Boleta de simulación por correo. Completar con el proveedor SMTP real.
# Mantener secretos solo en .env. No se envía correo si falta configuración.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

